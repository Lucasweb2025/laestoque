# Modo standalone (desenvolvimento do módulo Estoque)
VITE_MODO_EMBEDDED=false

# Quando integrado à plataforma principal, use base path do módulo:
# VITE_MODO_EMBEDDED=true
# VITE_BASE_PATH=/estoque
# GitHub Pages (modo pages — ver .env.pages):
# VITE_BASE_PATH=/laestoque
# VITE_DEMO_ESTATICO=true

# API compartilhada
VITE_API_BASE_URL=http://localhost:3000/api

# Unidade operacional (exibida na topbar)
VITE_UNIDADE_NOME=LaCustom
VITE_UNIDADE_FILIAL=Matriz · SP

# Dev only — substituído por window.__PLATAFORMA__.token no app pai
# VITE_DEV_TOKEN=
# VITE_DEV_PERFIL=gerente
